# .env de produção (VPS): copie para /opt/plenario/.env e preencha.
# Nunca versione o .env com valores reais.
APP_ENV=production
APP_NAME="Plenário Vera"
APP_BASE_URL=https://plenariovera.com.br
APP_PROD_DOMAIN=plenariovera.com.br
APP_TIMEZONE=America/Cuiaba
APP_DEBUG=0
# Gere com: openssl rand -hex 32
APP_KEY=

# MySQL compartilhado da VPS (serviço Swarm mysql_mysql, rede SGDMNET).
DB_HOST=mysql_mysql
DB_PORT=3306
DB_NAME=plenario
DB_USER=plenario
DB_PASS=
DB_CHARSET=utf8mb4

# Administrador inicial: criado só na primeira migração (banco sem usuários).
# Senha com 10+ caracteres. Depois do primeiro acesso, pode apagar estas duas linhas.
ADMIN_EMAIL=
ADMIN_PASSWORD=

SESSION_NAME=plenario_session

# SAPL da Câmara (importação de sessões; só leitura).
SAPL_URL=https://sapl.vera.mt.leg.br

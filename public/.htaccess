<IfModule mod_rewrite.c>
    RewriteEngine On

    # XAMPP local: descomente se o site estiver em /producao/votacao/public/
    # RewriteBase /producao/votacao/public/

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [QSA,L]
</IfModule>
